# Clipping Studio configuration
# Copy to .env and fill in only what you need. Everything works in demo mode
# with no keys at all.

# ---------------------------------------------------------------- dashboard
HOST=127.0.0.1
PORT=8765
DEMO_MODE=true
FLASK_DEBUG=false

# ---------------------------------------------------------------- your AI
# Any OpenAI-compatible endpoint (OpenAI, Groq, OpenRouter, DeepSeek, Ollama,
# LM Studio, Together, Fireworks, Cerebras, ...). Leave blank to run heuristic
# detection + local ffmpeg clipping with no AI.
MY_AI_ENDPOINT_URL=
MY_AI_API_KEY=
MY_AI_MODEL=
MY_AI_FAST_MODEL=

# Whisper transcription endpoint. Defaults to MY_AI_ENDPOINT_URL + /audio/transcriptions.
WHISPER_BASE_URL=
WHISPER_API_KEY=
WHISPER_MODEL=whisper-1
AI_TIMEOUT_SECONDS=90
AI_TRANSCRIBE_TIMEOUT_SECONDS=300

# Optional: auto-detect a local Ollama install when no endpoint is set.
USE_OLLAMA=false

# ---------------------------------------------------------------- detection
BUFFER_SECONDS=360
SEGMENT_SECONDS=10
SPIKE_PRE_SECONDS=30
SPIKE_POST_SECONDS=15
LOUDNESS_SPIKE_DB=6
CHAT_SPIKE_MULTIPLIER=3
AUTO_CLIP_ENABLED=true
AUTO_CLIP_COOLDOWN_SECONDS=60
MAX_AUTO_CLIPS_PER_STREAM=0
BROADCAST_DELAY_SECONDS=45
LIVE_TRANSCRIBE_INTERVAL=20
LIVE_TRANSCRIBE_WINDOW=20
MONITOR_POLL_SECONDS=30

# ---------------------------------------------------------------- storage
CHUNK_SECONDS=300
MAX_RECORDING_GB=0
MAX_VOD_MINUTES=0

# ---------------------------------------------------------------- live sources
# Twitch API (live checks + Helix). Create at https://dev.twitch.tv/console
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_TOKEN=
YOUTUBE_API_KEY=

# ---------------------------------------------------------------- publishing
# YouTube Data API OAuth (resumable upload of Shorts)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# TikTok Content Posting API
TIKTOK_ACCESS_TOKEN=
TIKTOK_OPEN_ID=

# Instagram Graph API (Reels)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# Public HTTPS URL that serves this machine, required for Instagram uploads.
PUBLIC_BASE_URL=

# Extra safety: only these streamer usernames may auto-post to socials.
ALLOWED_STREAMERS=

# ---------------------------------------------------------------- tools
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
YTDLP_BIN=yt-dlp
OPEN_FOLDER_CMD=
